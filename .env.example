# Server Port and Environment
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB connection URI)
MONGODB_URI=mongodb://127.0.0.1:27017/salonbook

# Better Auth Configuration
BETTER_AUTH_SECRET=salonbook-ultra-secure-better-auth-secret-key-32chars
BETTER_AUTH_URL=http://localhost:5000

# Application URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Google OAuth Credentials (Optional - for Google Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Stripe Payments Configuration (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ImgBB Image Hosting API Key
IMGBB_API_KEY=your_imgbb_api_key_here

# Initial Admin Provisioning Credentials
ADMIN_EMAIL=admin@salonbook.com
ADMIN_PASSWORD=Admin1234!
